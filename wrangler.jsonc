/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hyphn-kv",
	"main": "src/index.ts",
	"compatibility_date": "2025-08-13",
	"observability": {
		"enabled": true
	},
	"routes": [{
			"pattern": "hpyhn.xyz/worker/*", 
			"zone_id": "2e52930e6a02029b7d0eeffbed0a5ddc" 
		}
	],
	//保留分配的 workers.dev 域名
	"workers_dev": true,
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	// "vars": { "MY_VARIABLE": "production_value" }
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
	"kv_namespaces": [
		{
			"binding": "HPYHN_KV",
			"id": "1e5fac713d064cb5aefa5f3b0052ed46",
      		"preview_id": "1e5fac713d064cb5aefa5f3b0052ed46"
		},
    	{
			"binding": "HPYHN_INTERESTS",
			"id": "43a288977250407cafb92fb974d928a6",
			"preview_id": "43a288977250407cafb92fb974d928a6"
		},
    	{
			"binding": "HPYHN_INTERESTS_SCORE",
			"id": "67e6d94f03454c4c92e12d7c3e5a9572",
			"preview_id": "67e6d94f03454c4c92e12d7c3e5a9572"
		},
    	{
			"binding": "HPYHN_FAVORITES_POSTS",
			"id": "0050d21aeaa14120b22fd350f7761f2c",
			"preview_id": "0050d21aeaa14120b22fd350f7761f2c"
		},
    	{
			"binding": "HPYHN_DONTMISS_POSTS",
			"id": "6e737a1dea164290ae77468d72c854ab",
			"preview_id": "1232354324322q23332"
		},
    	{
			"binding": "HPYHN_READED_POSTS",
			"id": "7703cb5597624767992bddbceb2be54d",
			"preview_id": "7703cb5597624767992bddbceb2be54d"
		},
    	{
			"binding": "HPYHN_SUBSCRIPTION",
			"id": "0a1b2ece1b694163a87de61b5ade2026",
			"preview_id": "0a1b2ece1b694163a87de61b5ade2026"
		}
	],
  "triggers": {
    "crons": [
      "0 * * * *", // 每小时执行一次，写 KV 到数据库
      "20 * * * *", // 每小时第30分钟执行一次，刷数据库到 KV
	  "40 * * * *" // 每小时第20分钟执行一次，从hackernews同步数据到数据库
	  //"30 * * * *", 
	  //"40 * * * *"
    ]
  },
  "vars": {
    "REFRESH_KV_TOKEN": "abcf12e3596a972620659f0a7521d00460a4419a08e8aa2614d4cc80b367df35", // 仅用于非敏感数据
	"VERCEL_URL": "https://hpyhn.vercel.app",
	//"VERCEL_URL": "http://localhost:3000",
	"SUPABASE_URL": "https://abmsimxmbakqrxxcqjet.supabase.co",
	"AWS_LAMBDA_TRAIN_URL": "https://1gasp8qvpd.execute-api.us-east-1.amazonaws.com/train_asyn",
	"AWS_LAMBDA_SCORE_URL": "https://1gasp8qvpd.execute-api.us-east-1.amazonaws.com/score_asyn",
	"AWS_REGION": "us-east-1"
  }
}